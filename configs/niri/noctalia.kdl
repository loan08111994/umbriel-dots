layout {

    focus-ring {
        active-color   "#ccd975"
        inactive-color "#13140d"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ccd975"
        inactive-color "#13140d"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ccd975"
        inactive-color "#b0bd5d"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ccd97580"
    }
}

recent-windows {
    highlight {
        active-color "#ccd975"
        urgent-color "#ffb4ab"
    }
}
